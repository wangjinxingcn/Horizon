{
  "ai": {
    "provider": "anthropic",
    "model": "glm-5.3",
    "base_url": "https://ark.cn-beijing.volces.com/api/plan",
    "api_key_env": "ANTHROPIC_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-top5",
    "profile_settings": {
      "tech-top5": {
        "threshold": 0.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "rss": [
      {
        "name": "美团技术团队",
        "url": "https://tech.meituan.com/feed/",
        "enabled": true,
        "category": "engineering-blog",
        "profile": "tech-top5",
        "content_extractor": "trafilatura"
      },
      {
        "name": "LangChain Blog",
        "url": "https://blog.langchain.com/rss/",
        "enabled": true,
        "category": "ai-engineering",
        "profile": "tech-top5",
        "content_extractor": "trafilatura"
      },
      {
        "name": "InfoQ 中文站",
        "url": "https://www.infoq.cn/feed",
        "enabled": true,
        "category": "tech-news-cn",
        "profile": "tech-top5"
      },
      {
        "name": "InfoQ Architecture",
        "url": "https://feed.infoq.com/architecture/",
        "enabled": true,
        "category": "architecture-en",
        "profile": "tech-top5"
      }
    ]
  },
  "collection": {
    "time_window_hours": 49
  },
  "digest": {
    "max_items": 5,
    "profile_order": [
      "tech-top5"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "display": {
    "icon_style": "emoji"
  }
}
